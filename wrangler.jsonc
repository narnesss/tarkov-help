{
  "name": "tarkov-compass",
  "main": "cloudflare/worker.mjs",
  "keep_vars": true,
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api", "/api/*", "/profile-runtime.mjs", "/important-items", "/important-items.html",
      "/", "/index.html", "/account", "/account.html", "/privacy", "/privacy.html",
      "/documents", "/documents.html", "/documents/*", "/raid", "/raid.html", "/raid/*",
      "/quests", "/quests.html", "/quests/*", "/quest", "/quest.html",
      "/reference", "/reference.html", "/reference/*", "/boss", "/boss.html", "/boss/*"
    ],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    "API_ORIGIN": "https://narnes.alwaysdata.net"
  }
}
