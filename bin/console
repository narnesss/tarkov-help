#!/usr/bin/env php
<?php
declare(strict_types=1);

// Совместимость прежней команды сборки; основной CLI теперь Artisan.
if (($argv[1] ?? '') === 'export:static') { $argv[1] = 'site:export'; $_SERVER['argv'] = $argv; }
if (($argv[1] ?? '') === 'prices:refresh') {
    echo "Обновление цен отключено. Удалите прежнее cron-задание.\n";
    exit(0);
}
require dirname(__DIR__).'/artisan';
