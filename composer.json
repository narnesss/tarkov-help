{
  "name": "eft-wiki/application",
  "description": "Tarkov Wiki — Laravel 13, карты и личный прогресс",
  "type": "project",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "EftWiki\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": "@php artisan test",
    "export": "@php artisan site:export"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
